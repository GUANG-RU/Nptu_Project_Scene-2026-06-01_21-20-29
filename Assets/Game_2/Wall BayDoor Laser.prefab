  encounterStages:
  - stageName: First
    messages:
    - What is this?
    - It looks like a laser guide device.
    - 'And it seems to match the pattern I need to create for mirrored light guiding. '
    - Let's try pressing E to rotate the mirror and guide the light to the receiver!
  - stageName: Second
    messages:
    - Another laser puzzle, let's try again!
    - I hope this is the last time.
  - stageName: Third
    messages:
    - ...
    - FU*O*K
  displayTime: 3
  storyManager: {fileID: 0}
