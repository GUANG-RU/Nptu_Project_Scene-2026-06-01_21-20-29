  m_Name: IntroStoryDatabase
  m_EditorClassIdentifier: Assembly-CSharp::StoryDatabaseSO
  eventConfigs:
  - eventTypeKey: Intro
    encounterStages:
    - stageName: First
      messages:
      - 'Light was once meant to guide us through the darkness.


        But in
        one forgotten place, it became the source of fear.

        (Left-click to
        skip)'
      - "Deep within the shadows stood the \"Lightwave Research Institute\" \u2014
        a secret facility dedicated to the study of light and human consciousness."
      - 'Until one day, an experiment went terribly wrong.


        Space began
        to distort, and light no longer followed the laws of nature.'
      - 'The institute was abandoned.


        Yet something unnatural still wanders
        within its walls...'
      - 'Years passed...


        You slowly open your eyes on the cold floor of
        an unfamiliar place.'
      - 'Your memories are gone.


        You cannot remember who you are, or why
        you are here.'
      - 'A strange sound echoes from somewhere in the distance.


        What secrets
        lie hidden within this forgotten facility?'
      - 'For now, there is only one thing you can do...


        Find a way out.


        Before
        it''s too late.'
      voiceClips:
      - {fileID: 8300000, guid: 3d7a739c1e603144cbb319cf44e2d59c, type: 3}
